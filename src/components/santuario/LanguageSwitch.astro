---
import { alternateHref, languageFromPath } from '../../lib/santuario/i18n';
const lang = languageFromPath(Astro.url.pathname);
const other = lang === 'en' ? 'es' : 'en';
---

<div class="language-switch">
  <button type="button" id="menu-button" aria-expanded="false" aria-haspopup="true" aria-controls="lang-menu">
    {lang.toUpperCase()}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.293 9.293a1 1 0 011.414 0L10 12.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
    </svg>
  </button>
  <div id="lang-menu" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1" hidden>
    <div role="none"><a href={alternateHref(Astro.url.pathname, other)} hreflang={other} lang={other} role="menuitem" tabindex="-1">{other.toUpperCase()}</a></div>
  </div>
</div>
