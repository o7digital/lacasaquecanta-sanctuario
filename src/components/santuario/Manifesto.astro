---
import { getI18n } from '../../lib/santuario/i18n';
const { copy, home } = getI18n(Astro.url);
---

<section id="mirada" class="manifesto"><div class="manifesto-photo"><img src="/santuario/assets/editorial/garden.webp" alt={copy.gardenAlt} loading="lazy" width="1024" height="1280" /><span>{copy.detailCaption}</span></div><div class="manifesto-copy"><p class="eyebrow">{copy.perspective.toUpperCase()}</p><h2>{copy.manifestoTitle[0]}<br />{copy.manifestoTitle[1]}<br /><em>{copy.manifestoTitle[2]}</em></h2><p>{copy.manifestoBody[0]}</p><p>{copy.manifestoBody[1]}</p><a class="text-link" href={`${home}lecturas/un-lugar-para-volver-a-uno-mismo/`}>{copy.manifestoLink} <span aria-hidden="true">↗</span></a></div></section>
