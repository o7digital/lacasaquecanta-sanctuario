---
import { getI18n } from '../../lib/santuario/i18n';
const { copy, home } = getI18n(Astro.url);
---

<section class="cover"><div class="cover-copy"><p class="eyebrow"><span class="tiny-line"></span> {copy.coverLabel}</p><h2>{copy.coverTitle[0]} <br /><em>{copy.coverTitle[1]}</em><br /> {copy.coverTitle[2]}</h2><p class="cover-intro">{copy.coverIntro}</p><a class="circle-link" href={`${home}lecturas/el-arte-de-no-tener-prisa/`}><span>{copy.enterStory}</span><span class="circle-arrow" aria-hidden="true">↗</span></a><p class="cover-bottom">{copy.categories.Naturaleza.toUpperCase()} <span>4 {copy.minutes}</span></p></div><a class="cover-photo" href={`${home}lecturas/el-arte-de-no-tener-prisa/`} aria-label={copy.readCover}><img src="/santuario/assets/editorial/coast.webp" alt={copy.coverAlt} fetchpriority="high" width="1536" height="1024" /><span class="photo-number">{copy.coverCaption}</span><span class="photo-word">{copy.breathe}</span></a></section>
