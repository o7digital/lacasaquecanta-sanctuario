---
import { getI18n } from '../../lib/santuario/i18n';
const { copy, home } = getI18n(Astro.url);
---

<footer><div class="footer-top"><a class="footer-name" href={home}>El Santuario<span>{copy.byline}</span></a><p>{copy.footerLines[0]}<br />{copy.footerLines[1]}</p><a class="back-top" href="#top">{copy.backTop}</a></div><div class="footer-bottom"><span>{copy.location.replace(', ', ' · ')}</span><span>{copy.demo}</span><span>© LA CASA QUE CANTA 2026</span></div></footer>
