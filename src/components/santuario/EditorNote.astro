---
import { getI18n } from '../../lib/santuario/i18n';
const { copy } = getI18n(Astro.url);
---

<section class="editor-note"><span class="note-star" aria-hidden="true">✳</span><p>{copy.noteLines[0]}<br />{copy.noteLines[1]}<br />{copy.noteLines[2]} <em>{copy.noteEmphasis}</em></p><span class="note-signature">{copy.welcome}</span></section>
